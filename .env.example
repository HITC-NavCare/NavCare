# Copy this file to .env and fill in your own values for local development.
# .env is ignored by git. In Cloud Run, these values will come from Secret Manager.
# Do not put real values in this file.

# Google Cloud project and region the app will use.
# The v2 agent calls Gemini (Vertex AI) in this project.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=northamerica-northeast1

# Optional: Gemini model and Vertex AI location for the v2 agent.
# Defaults: gemini-3.8-flash and global.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_LOCATION=global

# Key from https://www.weatherapi.com (free tier).
WEATHER_API_KEY=replace-me

# Key for the Google Maps Routes API (driving times), created in the Google Cloud console.
# Enable "Routes API" in the project and restrict the key to it.
GOOGLE_MAPS_API_KEY=replace-me
