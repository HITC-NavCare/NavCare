# Copy this file to .env and fill in your own values for local development.
# .env is ignored by git. In Cloud Run, these values will come from Secret Manager.
# Do not put real values in this file.

# Google Cloud project and region the app will use.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=northamerica-northeast1

# Key from https://www.weatherapi.com (free tier).
WEATHER_API_KEY=replace-me

# Key for the Google Maps Routes API, created in the Google Cloud console.
GOOGLE_MAPS_API_KEY=replace-me
